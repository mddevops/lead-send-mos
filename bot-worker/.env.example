BOT_API_BASE_URL=http://localhost/api
BOT_API_TOKEN=
BOT_DEFAULT_DISK=local
BOT_HEADLESS=false
# chromium | camoufox — по умолчанию Chromium (установленный Chrome)
BOT_BROWSER=chromium
BOT_USE_INSTALLED_CHROME=true
BOT_LOCALE=ru-RU
BOT_TIMEZONE=Europe/Moscow
BOT_VIEWPORT_WIDTH=1280
BOT_VIEWPORT_HEIGHT=720
BOT_POLL_INTERVAL_MS=3000
# Параллельных браузеров (1–8). Локально: 1. Прод 6CPU/6GB: 3.
BOT_CONCURRENCY=1
BOT_SCAN_PAGE_WAIT_MS=4000
BOT_DEBUG_PAUSE_MS=15000
BOT_SLOW_MO=80
# ruCaptcha — https://rucaptcha.com/api-rucaptcha
CAPTCHA_SOLVER_ENABLED=true
CAPTCHA_SOLVER_API_KEY=
CAPTCHA_SOLVER_PROVIDER=rucaptcha
